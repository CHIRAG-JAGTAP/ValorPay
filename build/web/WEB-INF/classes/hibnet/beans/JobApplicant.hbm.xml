<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC 
"-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="hibnet.beans">
    <class name="JobApplicant" table="armyjobapplicants">     
        <id name="jobId" column="jobid">
            <generator class="native"/>
        </id>
        <property name="fullName" column="fullname"/>
        <property name="photo" column="photo"/>
        <property name="email" column="email"/>
        <property name="contact" column="contact"/>
        <property name="applyFor" column="applyfor"/>
        <property name="relativeName" column="relativename"/>
        <property name="relation" column="relation"/>
        <property name="address" column="address"/>
        <property name="city" column="city"/>
        <property name="pincode" column="pincode"/>
        <property name="gender" column="gender"/>
        <property name="school" column="school"/>
        <property name="college" column="college"/>
        <property name="aadharNo" column="aadharno"/>
        <property name="accountNo" column="accountno"/>
        <property name="pancardNo" column="pancardno"/>
        <property name="armyDoc" column="armydoc"/>
    </class>
</hibernate-mapping>


